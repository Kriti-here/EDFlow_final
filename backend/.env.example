# PayPal Sandbox credentials — never commit real values.
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=replace_me
BUYER_EMAIL=buyer@example.test
MERCHANT_EMAIL=
ALLOW_UNVERIFIED_WEBHOOKS=false

# Local application settings
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Comma-separated allowlist. Vite falls back to 5174/5175 when 5173 is taken, so
# the local defaults include all three; production sets this to the real URL(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
DATABASE_URL=sqlite:///./edflow.sqlite
DEMO_ADMIN_KEY=replace_me

# B10 FIRA extraction (placeholders)
FIRA_MAX_UPLOAD_BYTES=5242880
FIRA_CONFIDENCE_THRESHOLD_BP=9000

# B8 AI layer. Disabled by default. The /ai router serves only when AI_ENABLED=true
# AND AI_MODE is not "off". AI_MODE: off | replay | record | live.
#   off    = no provider is ever called (default)
#   replay = serve recorded fixtures from AI_CACHE_DIR; zero network access
#   record = call the provider on a cache miss and record the answer
#   live   = always call the provider; record nothing
AI_ENABLED=false
AI_MODE=off
AI_PROVIDER=gemini
# Read from the environment only (AGENTS.md rule 3). Leave blank to disable.
AI_API_KEY=
GEMINI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_CACHE_DIR=../fixtures/ai
