# Backend environment variables for Render production deployment.
# Copy to Render dashboard: Environment → Environment Variables
# Never commit real values. This file is git-tracked as a template only.

# ── Database ──────────────────────────────────────────────────────────────────
# Render provides this automatically when you link a PostgreSQL service.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://edflow:CHANGE_ME@RENDER_DB_HOST:5432/edflow

# ── Application URLs ──────────────────────────────────────────────────────────
# Your Render Web Service URL (assigned after first deploy)
PUBLIC_BASE_URL=https://edflow-api.onrender.com
# Your Vercel frontend URL
FRONTEND_URL=https://edflow.vercel.app
# Comma-separated allowed CORS origins (must match FRONTEND_URL exactly)
CORS_ORIGINS=https://edflow.vercel.app

# ── PayPal Sandbox ────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_WEBHOOK_ID=CHANGE_ME
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
MERCHANT_EMAIL=
BUYER_EMAIL=
ALLOW_UNVERIFIED_WEBHOOKS=false

# ── Admin & Security ──────────────────────────────────────────────────────────
DEMO_ADMIN_KEY=CHANGE_ME_USE_STRONG_RANDOM_SECRET

# ── FIRA extraction ───────────────────────────────────────────────────────────
FIRA_MAX_UPLOAD_BYTES=5242880
FIRA_CONFIDENCE_THRESHOLD_BP=9000

# ── AI layer (disabled by default) ───────────────────────────────────────────
AI_ENABLED=false
AI_MODE=off
AI_PROVIDER=none
# Uncomment and set only if enabling AI:
# AI_API_KEY=
# GEMINI_API_KEY=
