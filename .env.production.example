# Frontend environment variables for Vercel production deployment.
# In Vercel dashboard: Settings → Environment Variables
# All VITE_* variables are inlined at build time (not secret — do not put secrets here).

# Base URL of the deployed Render backend (no trailing slash).
# Example: https://edflow-api.onrender.com
VITE_API_BASE_URL=https://your-render-service.onrender.com
